/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com/beacon.min.js; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://github-readme-activity-graph.vercel.app; frame-src 'self' https://www.youtube.com https://app.kit.com; form-action 'self' https://app.kit.com;

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/logo.svg
  Cache-Control: public, max-age=86400, must-revalidate

/manifest.json
  Cache-Control: public, max-age=86400, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

/*.webp
  Cache-Control: public, max-age=86400, must-revalidate

/project-previews/*
  Cache-Control: public, max-age=86400, must-revalidate

/signature.svg
  Cache-Control: public, max-age=86400, must-revalidate

/sw.js
  Cache-Control: no-cache
